local function makeSegBar(parent, barColor)
	local bc = Instance.new("Frame")
	bc.Size = UDim2.new(1, 0, 1, 0)
	bc.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	bc.BorderSizePixel = 0
	bc.ClipsDescendants = false
	bc.Parent = parent
	local sk = Instance.new("UIStroke")
	sk.Color = Color3.fromRGB(0, 0, 0)
	sk.Thickness = 1.5
	sk.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	sk.Parent = bc
	local segs = {}
	local gap = 0.01
	local segH = (1 - gap * 4) / 5
	for i = 1, 5 do
		local yPos = 1 - (i * segH) - ((i - 1) * gap)
		local sb = Instance.new("Frame")
		sb.Size = UDim2.new(1, 0, segH, 0)
		sb.Position = UDim2.new(0, 0, yPos, 0)
		sb.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		sb.BorderSizePixel = 0
		sb.ClipsDescendants = true
		sb.Parent = bc
		local fi = Instance.new("Frame")
		fi.Size = UDim2.new(1, 0, 1, 0)
		fi.BackgroundColor3 = barColor
		fi.BorderSizePixel = 0
		fi.Parent = sb
		segs[i] = {bg = sb, fill = fi}
	end
	return segs
end

