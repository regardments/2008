local RayHook = {
	Installed = false,
	Handler = nil,
	BaseNamecall = nil,
}

local NoFallHook = {
	Installed = false,
	Handler = nil,
}

local function RebuildNamecallHooks()
	if type(hookmetamethod) ~= "function" or type(newcclosure) ~= "function" or type(getnamecallmethod) ~= "function" then
		return false
	end

	if not RayHook.BaseNamecall then
		local captured
		local ok = pcall(function()
			captured = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				return captured(self, ...)
			end))
		end)
		if not ok or not captured then return false end
		RayHook.BaseNamecall = captured
	end

	local ok = pcall(function()
		hookmetamethod(game, "__namecall", RayHook.BaseNamecall)
		RayHook.Handler = nil
		NoFallHook.Handler = nil

		if RayHook.Installed then
			local old = RayHook.BaseNamecall
			RayHook.Handler = newcclosure(function(self, ...)
				if Move.Noclip and Alive and getnamecallmethod() == "Raycast" then return nil end
				return old(self, ...)
			end)
			hookmetamethod(game, "__namecall", RayHook.Handler)
		end

		if NoFallHook.Installed then
			local old = RayHook.Installed and RayHook.Handler or RayHook.BaseNamecall
			NoFallHook.Handler = newcclosure(function(self, ...)
				if not Removals.NoFall or not Alive then return old(self, ...) end
				local method = getnamecallmethod()
				if method == "FireServer" and typeof(self) == "Instance" then
					local args = {...}
					if type(args[1]) == "number" and type(args[2]) == "boolean" and args[1] > 2 and args[2] == false then return end
				end
				return old(self, ...)
			end)
			hookmetamethod(game, "__namecall", NoFallHook.Handler)
		end
	end)

	return ok
end

local function InstallRaycastHook()
	if RayHook.Installed then return end
	if type(hookmetamethod) ~= "function" or type(newcclosure) ~= "function" or type(getnamecallmethod) ~= "function" then return end
	RayHook.Installed = true
	if not RebuildNamecallHooks() then
		RayHook.Installed = false
		RebuildNamecallHooks()
	end
end

local function RemoveRaycastHook()
	if not RayHook.Installed then return end
	RayHook.Installed = false
	RebuildNamecallHooks()
end

local function InstallNoFallHook()
	if NoFallHook.Installed then return end
	if type(hookmetamethod) ~= "function" or type(newcclosure) ~= "function" or type(getnamecallmethod) ~= "function" then return end
	NoFallHook.Installed = true
	if not RebuildNamecallHooks() then
		NoFallHook.Installed = false
		RebuildNamecallHooks()
	end
end

local function RemoveNoFallHook()
	if not NoFallHook.Installed then return end
	NoFallHook.Installed = false
