end

local function updateSegs(segs, ratio, color)
	if not segs then return end
	for i = 1, 5 do
		local seg = segs[i]
		if seg and seg.fill then
			local fr = math.clamp((ratio - (i - 1) / 5) / 0.2, 0, 1)
			seg.fill.BackgroundColor3 = color
			TweenService:Create(seg.fill, segTI, {
				Size = UDim2.new(1, 0, fr, 0),
				Position = UDim2.new(0, 0, 1 - fr, 0)
			}):Play()
		end
	end
end

local function updateSegsH(segs, ratio, color)
	if not segs then return end
	for i = 1, 5 do
		local seg = segs[i]
		if seg and seg.fill then
			local fr = math.clamp((ratio - (i - 1) / 5) / 0.2, 0, 1)
			seg.fill.BackgroundColor3 = color
			TweenService:Create(seg.fill, segTI, {
				Size = UDim2.new(fr, 0, 1, 0),
				Position = UDim2.new(0, 0, 0, 0)
			}):Play()
