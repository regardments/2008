task.defer(function()
	local parent = (gethui and gethui()) or game:GetService("CoreGui")
	local function hook(gui)
		if not gui or not gui:IsA("ScreenGui") then return end
		if string.find(gui.Name, "Meow_") then
			gui.Destroying:Connect(FullCleanup)
			return true
		end
	end
	for _, gui in ipairs(parent:GetChildren()) do
		if hook(gui) then break end
	end
	parent.ChildAdded:Connect(function(child)
		task.defer(function() hook(child) end)
	end)
end)
