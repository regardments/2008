	lbl.Font = Enum.Font.Ubuntu
	lbl.TextScaled = false
	lbl.TextSize = 12
	lbl.Text = "Loot"
	lbl.Parent = bg
	ChestESP.PerChest[obj] = {billboard = bg, label = lbl, part = part, lastText = ""}
end

local function tryAddChest(obj)
	if not obj or not obj:IsA("Model") or obj.Name ~= "Model" then return end
	task.defer(function()
		task.wait(0.1)
		if obj and obj.Parent and not ChestESP.Opened[obj] then
			createChestBillboard(obj)
		end
	end)
end

local function EnableChestESP()
	if not Alive then return end
	ChestESP.Enabled = true

	local thrown = workspace:FindFirstChild("Thrown")
	if not thrown then
		task.spawn(function()
			thrown = workspace:WaitForChild("Thrown", 10)
			if not thrown or not ChestESP.Enabled then return end
			for _, c in ipairs(thrown:GetChildren()) do
				tryAddChest(c)
			end
			if ChestESP.AddedConn then ChestESP.AddedConn:Disconnect() end
			if ChestESP.RemovedConn then ChestESP.RemovedConn:Disconnect() end
			ChestESP.AddedConn = thrown.ChildAdded:Connect(function(c)
				if ChestESP.Enabled then task.wait(0.15); tryAddChest(c) end
			end)
			ChestESP.RemovedConn = thrown.ChildRemoved:Connect(removeChest)
		end)
		return
	end

	for _, c in ipairs(thrown:GetChildren()) do
		tryAddChest(c)
	end

	if ChestESP.AddedConn then ChestESP.AddedConn:Disconnect() end
	if ChestESP.RemovedConn then ChestESP.RemovedConn:Disconnect() end

	ChestESP.AddedConn = thrown.ChildAdded:Connect(function(c)
		if ChestESP.Enabled then task.wait(0.15); tryAddChest(c) end
	end)
	ChestESP.RemovedConn = thrown.ChildRemoved:Connect(removeChest)

	if ChestConn then ChestConn:Disconnect() end
	ChestConn = RunService.Heartbeat:Connect(function()
		if not Alive or not ChestESP.Enabled then return end
		local now = tick()
		if now - lastChestTick < CHEST_RATE then return end
		lastChestTick = now

		local myChar = LP.Character
		local myRoot = myChar and GetRoot(myChar)
		if not myRoot then return end
		local myPos = myRoot.Position
		local cam = workspace.CurrentCamera

		for obj, d in pairs(ChestESP.PerChest) do
			if not d.part or not d.part.Parent or not obj.Parent then
				removeChest(obj)
			else
				local dist = (myPos - d.part.Position).Magnitude
				if dist <= 25 then
					ChestESP.Opened[obj] = true
					removeChest(obj)
				elseif dist > ChestESP.Distance then
					if d.billboard.Enabled then d.billboard.Enabled = false end
				else
					local _, onSc = cam:WorldToViewportPoint(d.part.Position)
					if d.billboard.Enabled ~= onSc then d.billboard.Enabled = onSc end
					if onSc then
						local nt = string.format("Loot\n(%d studs)", math.floor(dist + 0.5))
						if nt ~= d.lastText then
							d.label.Text = nt
							d.lastText = nt
						end
					end
				end
			end
		end
	end)
end

local function DisableChestESP()
	ChestESP.Enabled = false
	if ChestConn then ChestConn:Disconnect(); ChestConn = nil end
	if ChestESP.AddedConn then ChestESP.AddedConn:Disconnect(); ChestESP.AddedConn = nil end
	if ChestESP.RemovedConn then ChestESP.RemovedConn:Disconnect(); ChestESP.RemovedConn = nil end
	for obj in pairs(ChestESP.PerChest) do removeChest(obj) end
	ChestESP.PerChest = {}
	ChestESP.Opened = {}
end

local function UpdateESP()
	if not Alive or not EspData.Enabled then return end
	local now = tick()
	if now - lastEspTick < ESP_RATE then return end
	lastEspTick = now

	local myChar = LP.Character
	local myRoot = myChar and GetRoot(myChar)
	if not myRoot then return end
	local myPos = myRoot.Position
	local cam = workspace.CurrentCamera
	local distMax = EspData.Distance
	local distMaxSq = distMax * distMax
	local live = GetLive()

	for player, pd in pairs(EspData.PerPlayer) do
		if player ~= LP then
			local char = player.Character
			if not char then
				setAllEnabled(pd, false)
			else
				local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
				local hum = char:FindFirstChildOfClass("Humanoid")
				if not root or not hum then
					setAllEnabled(pd, false)
					if not pd._waitingForChar then
						pd._waitingForChar = true
						task.spawn(function()
							if not waitCharReady(char) then pd._waitingForChar = nil; return end
							if Alive and EspData.Enabled and player.Character == char then
								applyAllESPToChar(player, char)
							end
							pd._waitingForChar = nil
						end)
					end
				else
					pd._waitingForChar = nil
					local labelRoot = char:FindFirstChild("Head") or root
					if EspData.Enabled then
						if not pd.billboard or pd.billboard.Parent ~= labelRoot then
							createPlayerBillboard(player, char)
							pd = EspData.PerPlayer[player]
						end
						if EspData.ShowBox and (not pd.boxBillboard or pd.boxBillboard.Parent ~= root) then
							createPlayerBoxBillboard(player, char)
							pd = EspData.PerPlayer[player]
						end
						if EspData.ShowHealthBar and (not pd.barBillboard or pd.barBillboard.Parent ~= root) then
							createPlayerBarBillboard(player, char)
							pd = EspData.PerPlayer[player]
						end
						if EspData.ShowStomachBar and (not pd.stomachBillboard or pd.stomachBillboard.Parent ~= root) then
							createPlayerStomachBillboard(player, char)
							pd = EspData.PerPlayer[player]
						end
						if EspData.ShowWaterBar and (not pd.waterBillboard or pd.waterBillboard.Parent ~= root) then
							createPlayerWaterBillboard(player, char)
							pd = EspData.PerPlayer[player]
						end
						if EspData.ShowEtherBar and (not pd.etherBillboard or pd.etherBillboard.Parent ~= root) then
							createPlayerEtherBillboard(player, char)
							pd = EspData.PerPlayer[player]
						end
						if EspData.ShowPostureBar and (not pd.postureBillboard or pd.postureBillboard.Parent ~= root) then
							createPlayerPostureBillboard(player, char)
							pd = EspData.PerPlayer[player]
						end
						if EspData.ShowBloodBar and (not pd.bloodBillboard or pd.bloodBillboard.Parent ~= root) then
							createPlayerBloodBillboard(player, char)
							pd = EspData.PerPlayer[player]
						end
						if EspData.ShowArmorBar and (not pd.armorBillboard or pd.armorBillboard.Parent ~= root) then
							createPlayerArmorBillboard(player, char)
							pd = EspData.PerPlayer[player]
						end
						if EspData.ShowSanityBar and (not pd.sanityBillboard or pd.sanityBillboard.Parent ~= root) then
							createPlayerSanityBillboard(player, char)
							pd = EspData.PerPlayer[player]
						end
					end

					pd = EspData.PerPlayer[player]
					if pd then
						local rPos = root.Position
						local dx = rPos.X - myPos.X
						local dy = rPos.Y - myPos.Y
						local dz = rPos.Z - myPos.Z
						local distSq = dx * dx + dy * dy + dz * dz
						local dist = math.sqrt(distSq)
						local vis = false
						if distSq <= distMaxSq and cam then
							local _, onSc = cam:WorldToViewportPoint(rPos)
							vis = onSc
						end

						local lc = live and live:FindFirstChild(player.Name)

						if pd.billboard and pd.label then
							if not vis then
								if pd.billboard.Enabled then pd.billboard.Enabled = false end
							else
								if not pd.billboard.Enabled then pd.billboard.Enabled = true end
								pd.label.TextColor3 = EspData.Color
								local parts = {}
								if EspData.ShowName then parts[#parts + 1] = player.Name end
								if EspData.ShowLevel then
									parts[#parts + 1] = "[Level " .. tostring(char:GetAttribute("Level") or player:GetAttribute("Level") or "?") .. "]"
								end
								if EspData.ShowGuild then parts[#parts + 1] = "Guild: " .. getGuild(player) end
								if EspData.ShowDistance then parts[#parts + 1] = "(" .. math.floor(dist + 0.5) .. " studs)" end
								if EspData.ShowHealth then
									local hp = 0
									local okH, hMax = pcall(function() return hum.MaxHealth end)
									local okV, hVal = pcall(function() return hum.Health end)
									if okH and okV and hMax and hMax > 0 then
										hp = math.floor(math.clamp(hVal / hMax, 0, 1) * 100 + 0.5)
									end
									parts[#parts + 1] = "[" .. hp .. "%]"
								end
								local nt = table.concat(parts, "\n")
								if nt ~= pd.lastLabelText then
									pd.label.Text = nt
									pd.lastLabelText = nt
								end
							end
						end

						if pd.boxBillboard then
							local should = EspData.ShowBox and vis
							if pd.boxBillboard.Enabled ~= should then pd.boxBillboard.Enabled = should end
						end

						if pd.barBillboard and pd.boxSegments then
							if not EspData.ShowHealthBar or not vis then
								if pd.barBillboard.Enabled then pd.barBillboard.Enabled = false end
							else
								if not pd.barBillboard.Enabled then pd.barBillboard.Enabled = true end
								local okH, hMax = pcall(function() return hum.MaxHealth end)
								local okV, hVal = pcall(function() return hum.Health end)
								if okH and okV and hMax and hMax > 0 then
									local hr = math.clamp(hVal / hMax, 0, 1)
									if math.abs(hr - (pd.lastHpRatio or -1)) > 0.005 then
										pd.lastHpRatio = hr
										updateSegs(pd.boxSegments, hr, Color3.new(
											math.clamp(2 * (1 - hr), 0, 1),
											math.clamp(2 * hr, 0, 1),
											0
										))
									end
								end
							end
						end

						local function updateRes(billKey, segsKey, lastKey, valName, enabled, fillC, lowC)
							local bill = pd[billKey]
							local segs = pd[segsKey]
							if not bill or not segs then return end
							if not enabled or not vis then
								if bill.Enabled then bill.Enabled = false end
								return
							end
							if not bill.Enabled then bill.Enabled = true end
							local ratio = 1
							local v = findValueInCharOrLive(char, lc, valName)
							if v then ratio = safeRatio(v) end
							if math.abs(ratio - (pd[lastKey] or -1)) > 0.005 then
								pd[lastKey] = ratio
								updateSegs(segs, ratio, Color3.new(
									lowC.R + (fillC.R - lowC.R) * ratio,
									lowC.G + (fillC.G - lowC.G) * ratio,
									lowC.B + (fillC.B - lowC.B) * ratio
								))
							end
						end

						updateRes("stomachBillboard", "stomachSegs", "lastStomachRatio", "Stomach", EspData.ShowStomachBar,
							Color3.fromRGB(210, 180, 50), Color3.fromRGB(180, 80, 20))
						updateRes("waterBillboard", "waterSegs", "lastWaterRatio", "Water", EspData.ShowWaterBar,
							Color3.fromRGB(50, 150, 255), Color3.fromRGB(20, 80, 200))
						updateRes("etherBillboard", "etherSegs", "lastEtherRatio", "Ether", EspData.ShowEtherBar,
							Color3.fromRGB(100, 220, 255), Color3.fromRGB(50, 180, 230))

						local function updateHoriz(billKey, segsKey, lastKey, valName, enabled, fillC, lowC)
							local bill = pd[billKey]
							local segs = pd[segsKey]
							if not bill or not segs then return end
							if not enabled or not vis then
								if bill.Enabled then bill.Enabled = false end
								return
							end
							if not bill.Enabled then bill.Enabled = true end
							local ratio = 0
							local v = findValueInCharOrLive(char, lc, valName)
							if v then ratio = safeRatio(v) end
							if math.abs(ratio - (pd[lastKey] or -1)) > 0.005 then
								pd[lastKey] = ratio
								updateSegsH(segs, ratio, Color3.new(
									lowC.R + (fillC.R - lowC.R) * ratio,
									lowC.G + (fillC.G - lowC.G) * ratio,
									lowC.B + (fillC.B - lowC.B) * ratio
								))
							end
						end

						updateHoriz("postureBillboard", "postureSegs", "lastPostureRatio", "BreakMeter", EspData.ShowPostureBar,
							Color3.fromRGB(255, 210, 0), Color3.fromRGB(190, 120, 20))
						updateHoriz("bloodBillboard", "bloodSegs", "lastBloodRatio", "Blood", EspData.ShowBloodBar,
							Color3.fromRGB(240, 80, 80), Color3.fromRGB(120, 10, 10))
						updateHoriz("armorBillboard", "armorSegs", "lastArmorRatio", "Armor", EspData.ShowArmorBar,
							Color3.fromRGB(220, 228, 236), Color3.fromRGB(120, 130, 140))
						updateHoriz("sanityBillboard", "sanitySegs", "lastSanityRatio", "Sanity", EspData.ShowSanityBar,
							Color3.fromRGB(170, 90, 230), Color3.fromRGB(90, 40, 140))
					end
				end
			end
		end
	end
end

