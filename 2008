local function isValidLiveMob(model)
	if not model or not model.Parent then return false end
	if not model:IsA("Model") then return false end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	if model == LP.Character then return false end
	if Players:GetPlayerFromCharacter(model) then return false end
	if model:FindFirstChild("InteractPrompt") then return false end
	local live = workspace:FindFirstChild("Live")
	if not live or model.Parent ~= live then return false end
	return true
end

local function getMobRoot(model)
	return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
end

local function removeMob(model)
	local d = MobESP.PerMob[model]
	if not d then return end
	if d.billboard then pcall(function() d.billboard:Destroy() end) end
	if d.highlight then pcall(function() d.highlight:Destroy() end) end
	MobESP.PerMob[model] = nil
end

local function createMobBillboard(model)
	if not isValidLiveMob(model) then return end
	local root = getMobRoot(model)
	if not root then return end
	local d = MobESP.PerMob[model]
	if d and d.billboard and d.billboard.Parent == root then return end
	if d then removeMob(model) end

	local bg = Instance.new("BillboardGui")
	bg.Name = "MobESP"
	bg.Adornee = root
	bg.StudsOffset = Vector3.new(0, 2.5, 0)
	bg.AlwaysOnTop = true
	bg.ResetOnSpawn = false
	bg.Size = UDim2.new(0, 120, 0, 60)
	bg.Parent = root

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1.5, 0, 1.5, 0)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = MobESP.Color
	lbl.TextStrokeTransparency = 0
	lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	lbl.Font = Enum.Font.Ubuntu
	lbl.TextScaled = false
	lbl.TextSize = 12
	lbl.Text = ""
	lbl.Parent = bg

	local hl = nil
	if MobESP.Highlight then
		hl = Instance.new("Highlight")
		hl.FillColor = MobESP.Color
		hl.OutlineColor = MobESP.Color
		hl.FillTransparency = 0.5
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Adornee = model
		hl.Parent = model
	end

	local cachedName = model.Name:gsub("^%.", ""):gsub("%d+$", "")
	local cachedHum = model:FindFirstChildOfClass("Humanoid")

	MobESP.PerMob[model] = {
		billboard = bg,
		label = lbl,
		highlight = hl,
		lastText = "",
		lastVisible = nil,
		cachedName = cachedName,
		cachedHum = cachedHum,
	}
end

local function tryAddMob(model)
	if MobESP.PerMob[model] or not isValidLiveMob(model) then return end
	local root = getMobRoot(model)
	if root then
		createMobBillboard(model)
	else
		task.spawn(function()
			local w = model:WaitForChild("Head", 2) or model:WaitForChild("HumanoidRootPart", 2)
			if not w or not isValidLiveMob(model) or MobESP.PerMob[model] then return end
			createMobBillboard(model)
		end)
	end
end

local function ClearMobESP()
	for model in pairs(MobESP.PerMob) do
		removeMob(model)
	end
	MobESP.PerMob = {}
end

local function EnableMobESP()
	if not Alive then return end
	MobESP.Enabled = true

	local live = GetLive()
	if live then
		for _, c in ipairs(live:GetChildren()) do
			tryAddMob(c)
		end
	end

	if MobESP.LiveAddedConn then MobESP.LiveAddedConn:Disconnect() end
	if MobESP.LiveRemovedConn then MobESP.LiveRemovedConn:Disconnect() end

	if live then
		MobESP.LiveAddedConn = live.ChildAdded:Connect(function(c)
			if MobESP.Enabled then
				task.wait(0.15)
				tryAddMob(c)
			end
		end)
		MobESP.LiveRemovedConn = live.ChildRemoved:Connect(removeMob)
	end

	if MobConn then MobConn:Disconnect() end
	MobConn = RunService.Heartbeat:Connect(function()
		if not Alive or not MobESP.Enabled then return end
		local now = tick()
		if now - lastMobTick < MOB_RATE then return end
		lastMobTick = now

		local myChar = LP.Character
		local myRoot = myChar and GetRoot(myChar)
		if not myRoot then return end
		local myPos = myRoot.Position
		local cam = workspace.CurrentCamera

		for model, d in pairs(MobESP.PerMob) do
			if not isValidLiveMob(model) then
				removeMob(model)
			else
				local root = getMobRoot(model)
				local hum = d.cachedHum
				if not hum or not hum.Parent then
					hum = model:FindFirstChildOfClass("Humanoid")
					d.cachedHum = hum
				end

				if root and hum and hum.Health > 0 then
					local rPos = root.Position
					local dist = (myPos - rPos).Magnitude
					local visible = dist <= MobESP.Distance
					if visible then
						local _, onSc = cam:WorldToViewportPoint(rPos)
						visible = onSc
					end

					if d.lastVisible ~= visible then
						d.lastVisible = visible
						if d.billboard then d.billboard.Enabled = visible end
						if d.highlight then d.highlight.Enabled = visible end
					end

					if visible then
						local nt = string.format("%s\n(%d studs)\n[%d/%d]",
							d.cachedName,
							math.floor(dist + 0.5),
							math.floor(hum.Health + 0.5),
							math.floor(hum.MaxHealth + 0.5)
						)
						if nt ~= d.lastText then
							d.label.Text = nt
							d.label.TextColor3 = MobESP.Color
							d.lastText = nt
						end
					end
				else
					if d.lastVisible ~= false then
						d.lastVisible = false
						if d.billboard then d.billboard.Enabled = false end
						if d.highlight then d.highlight.Enabled = false end
					end
				end
			end
		end
	end)
end

local function DisableMobESP()
	MobESP.Enabled = false
	if MobConn then
		MobConn:Disconnect()
		MobConn = nil
	end
	if MobESP.LiveAddedConn then
