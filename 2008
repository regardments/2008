	header.BorderSizePixel = 0
	header.ClipsDescendants = true
	header.Parent = frame

	local title = Instance.new("TextLabel")
	title.Position = UDim2.fromOffset(4, 0)
	title.Size = UDim2.new(1, -8, 1, 0)
