local function waitCharReady(char)
	local tries = 0
	while tries < 50 do
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hrp and head and hum and hrp.Parent == char and head.Parent == char then
			return true
		end
		tries = tries + 1
		task.wait(0.1)
	end
	return false
end

