Sections.VoidTitus:NewButton("Void Titus", "Void Titus", function()
	local character = LP.Character
	if not character then return end

	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local titus
	local liveFolder = workspace:FindFirstChild("Live")
	if not liveFolder then return end

	for _, v in ipairs(liveFolder:GetChildren()) do
		if string.find(string.lower(v.Name), "titus") then
			titus = v
			break
		end
	end

	if not titus then return end

	local targetRoot = titus:FindFirstChild("HumanoidRootPart")
	if not targetRoot then return end

	local wasNoclip = Move.Noclip
	if not Move.Noclip then
		EnableNoclip()
		if noclipTog and noclipTog.Set then noclipTog:Set(true) end
	end

	local breakerHeartbeat
	local breakerRender
	local savedVelocity

	breakerHeartbeat = RunService.Heartbeat:Connect(function()
		local char = LP.Character
		if not char then return end

		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		savedVelocity = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(0, -9e9, 0)
	end)

	breakerRender = RunService.PreRender:Connect(function()
		if not savedVelocity then return end

		local char = LP.Character
		if not char then return end

		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		hrp.AssemblyLinearVelocity = savedVelocity
	end)

	task.wait()

	local offset = CFrame.new(0, -1, 0)

	local tween = TweenService:Create(
		root,
		TweenInfo.new(3, Enum.EasingStyle.Linear),
		{
			CFrame = targetRoot.CFrame * offset
		}
	)

	tween:Play()

	task.delay(2.55, function()
		local VirtualInputManager = game:GetService("VirtualInputManager")

		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
		task.wait(0.5)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
	end)

	tween.Completed:Wait()

	local start = tick()

	while tick() - start < 1.3 do
		if not targetRoot.Parent then
			break
		end

		root.CFrame = targetRoot.CFrame * offset
		RunService.Heartbeat:Wait()
	end

	if breakerHeartbeat then
		breakerHeartbeat:Disconnect()
		breakerHeartbeat = nil
	end

	if breakerRender then
		breakerRender:Disconnect()
		breakerRender = nil
	end

	savedVelocity = nil

	if not wasNoclip then
		DisableNoclip()
		Save:SetValue("noclip_enable", false)
		if noclipTog and noclipTog.Set then noclipTog:Set(false) end
	end
end, { Confirm = true, ConfirmMessage = "Seguro que quieres voidear a Titus?" })

