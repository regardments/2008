local function FullCleanup()
	Alive = false
	Move.Noclip = false
	Move.Fly = false
	Removals.NoFall = false
	Removals.UnlockChat = false
	pcall(RemoveRaycastHook)

	if InputConn then InputConn:Disconnect(); InputConn = nil end
	if Move.NoclipConn then Move.NoclipConn:Disconnect(); Move.NoclipConn = nil end
	if Move.FlyConn then Move.FlyConn:Disconnect(); Move.FlyConn = nil end
	if EspConn then EspConn:Disconnect(); EspConn = nil end
	if Move.CharConn then Move.CharConn:Disconnect(); Move.CharConn = nil end
	if PlayerAddedConn then PlayerAddedConn:Disconnect(); PlayerAddedConn = nil end
	if PlayerRemovingConn then PlayerRemovingConn:Disconnect(); PlayerRemovingConn = nil end

	pcall(DisableFly)
	pcall(DisableNoclip)
	pcall(DisableNoFallDamage)
	pcall(DisableNoFog)
	pcall(DisableMobESP)
	pcall(DisableESP)
	pcall(DisableChestESP)
	pcall(DisableProximityESP)
	pcall(StopVoidMob)
	pcall(StopAllTeleportLoops)
	pcall(function()
		local cwc = TextChatService.ChatWindowConfiguration
		if cwc then cwc.Enabled = false end
	end)

	EspData.Enabled = false
	ClearESP()

	pcall(function() task.cancel(clientLoop) end)
end

