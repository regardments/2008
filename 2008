local function EnableNoFog()
	if not Alive then return end
	Removals.NoFog = true

	if Removals.FogOriginals.FogStart == nil then
		Removals.FogOriginals.FogStart = Lighting.FogStart
		Removals.FogOriginals.FogEnd = Lighting.FogEnd
		local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmo then
			Removals.FogOriginals.Density = atmo.Density
		end
	end

	Lighting.FogStart = 9e9
	Lighting.FogEnd = 9e9
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then atmo.Density = 0 end

	DisconnectFogConns()

	Removals.FogStartConn = Lighting:GetPropertyChangedSignal("FogStart"):Connect(function()
		if Removals.NoFog and Alive then Lighting.FogStart = 9e9 end
	end)
	Removals.FogEndConn = Lighting:GetPropertyChangedSignal("FogEnd"):Connect(function()
		if Removals.NoFog and Alive then Lighting.FogEnd = 9e9 end
	end)
	local atmo2 = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo2 then
		Removals.AtmoDensityConn = atmo2:GetPropertyChangedSignal("Density"):Connect(function()
			if Removals.NoFog and Alive then atmo2.Density = 0 end
		end)
	end
end

local function DisableNoFog()
	Removals.NoFog = false
	DisconnectFogConns()

	if Removals.FogOriginals.FogStart ~= nil then
		pcall(function() Lighting.FogStart = Removals.FogOriginals.FogStart end)
		pcall(function() Lighting.FogEnd = Removals.FogOriginals.FogEnd end)
