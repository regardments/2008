local function createSegBarBillboard(player, char, fieldName, billName, color, segsKey)
	if player == LP then return end
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local pd = EspData.PerPlayer[player]
	if pd and pd[billName] then
		if pd[billName].Parent == root then return end
		pcall(function() pd[billName]:Destroy() end)
		pd[billName] = nil
	end
	local bg = mkBB(fieldName, root)
	bg.ClipsDescendants = false
	local mf = Instance.new("Frame")
	mf.Size = UDim2.new(1, 0, 1, 0)
	mf.BackgroundTransparency = 1
	mf.BorderSizePixel = 0
	mf.Parent = bg
	local segs = makeSegBar(mf, color)
	szBar(bg)
	pd = EspData.PerPlayer[player] or {}
	pd[billName] = bg
	pd[segsKey] = segs
	EspData.PerPlayer[player] = pd
	recalcBarPositions(player)
end

