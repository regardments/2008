local function CreateFlyBV()
	local char = LP.Character
	if not char then return nil end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	if Move.BV then pcall(function() Move.BV:Destroy() end); Move.BV = nil end
	local bv = Instance.new("BodyVelocity")
	bv.Name = "DayuiFlyBV"
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.Velocity = Vector3.zero
	bv.Parent = root
	pcall(function() CollectionService:AddTag(bv, "AllowedBM") end)
	Move.BV = bv
	return bv
end

local function EnableFly()
	if not Alive then return end
	DisableFly()
	Move.Fly = true
	local char = LP.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end

	hum.PlatformStand = true
	CreateFlyBV()

	Move.FlyConn = RunService.RenderStepped:Connect(function()
		if not Alive or not Move.Fly then return end
		if not Move.BV or not Move.BV.Parent then
			CreateFlyBV()
			if not Move.BV then return end
		end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local dir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then
			dir = dir - Vector3.new(0, 1, 0)
		end
		if dir.Magnitude > 0 then
			Move.BV.Velocity = dir.Unit * Move.FlySpeed
		else
			Move.BV.Velocity = Vector3.zero
		end
	end)

	Move.FlyRefresh = task.spawn(function()
		while Alive and Move.Fly do
			task.wait(3)
			if not Alive or not Move.Fly then break end
			CreateFlyBV()
		end
	end)
end

local function RestoreWorldParts()
	for part, can in pairs(Move.WorldOrig) do
		pcall(function()
			if part and part.Parent then part.CanCollide = can end
		end)
	end
	Move.WorldOrig = {}
end

local function RestoreNoclip()
	if Move.NoclipConn then Move.NoclipConn:Disconnect(); Move.NoclipConn = nil end
	for part, can in pairs(Move.NoclipOrig) do
		pcall(function()
			if part and part.Parent then part.CanCollide = can end
		end)
	end
	Move.NoclipOrig = {}
	RestoreWorldParts()
end

local function ApplyNoclip()
	local char = LP.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			if Move.NoclipOrig[part] == nil then Move.NoclipOrig[part] = part.CanCollide end
			part.CanCollide = false
		end
	end
end

local function UpdateWorldNoclip()
	if not Move.Noclip or not Move.FullNoclip then
		RestoreWorldParts()
		return
	end
	local char = LP.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {char}

	local nearby = workspace:GetPartBoundsInRadius(root.Position, 250, params)
	local seen = {}

	for _, part in ipairs(nearby) do
		if part:IsA("BasePart") then
			seen[part] = true
			if Move.WorldOrig[part] == nil then Move.WorldOrig[part] = part.CanCollide end
			part.CanCollide = false
		end
	end

	for part, can in pairs(Move.WorldOrig) do
		if not seen[part] then
			pcall(function()
				if part and part.Parent then part.CanCollide = can end
			end)
			Move.WorldOrig[part] = nil
		end
	end
end

local function EnableNoclip()
	if not Alive then return end
	Move.Noclip = true
	InstallRaycastHook()
	ApplyNoclip()
	if Move.NoclipConn then Move.NoclipConn:Disconnect(); Move.NoclipConn = nil end
	Move.NoclipConn = RunService.Stepped:Connect(function()
		if not Alive or not Move.Noclip then return end
		local char = LP.Character
		if not char then return end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				if Move.NoclipOrig[part] == nil then Move.NoclipOrig[part] = part.CanCollide end
				part.CanCollide = false
			end
		end
		if Move.FullNoclip then UpdateWorldNoclip() else RestoreWorldParts() end
	end)
end

local function DisableNoclip()
	Move.Noclip = false
	RemoveRaycastHook()
	RestoreNoclip()
end

