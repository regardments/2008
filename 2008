		if atmo and Removals.FogOriginals.Density ~= nil then
			pcall(function() atmo.Density = Removals.FogOriginals.Density end)
		end
	end

	Removals.FogOriginals.FogStart = nil
	Removals.FogOriginals.FogEnd = nil
	Removals.FogOriginals.Density = nil
end

