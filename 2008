local function UpdateProximityList(entries)
	local list = ProximityESP.List
	if not list then return end

	local T = Library.GetTheme and Library:GetTheme() or {}
	local bindTheme = Library.BindTheme
	local rowColor = T.TextDim or Color3.fromRGB(140, 140, 145)

	local existing = {}
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") then
			existing[child.Name] = child
		end
	end

	local seen = {}
	for i, entry in ipairs(entries) do
		seen[entry.name] = true
		local row = existing[entry.name]
		if not row then
			row = Instance.new("Frame")
			row.Name = entry.name
			row.Size = UDim2.new(1, 0, 0, 18)
			row.BackgroundTransparency = 1
			row.BorderSizePixel = 0
			row.LayoutOrder = i
			row.Parent = list

			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, -8, 1, 0)
			lbl.Position = UDim2.new(0, 4, 0, 0)
			lbl.BackgroundTransparency = 1
			lbl.Font = Enum.Font.SourceSans
			lbl.TextSize = 12
			lbl.TextColor3 = rowColor
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			lbl.TextYAlignment = Enum.TextYAlignment.Center
			lbl.Parent = row

			if bindTheme then bindTheme(lbl, { TextColor3 = "TextDim" }) end
		end

		local lbl = row:FindFirstChildOfClass("TextLabel")
		if lbl then
			lbl.Text = string.format("%s  %d studs", entry.name, math.floor(entry.dist + 0.5))
		end
		row.LayoutOrder = i
	end

	for name, row in pairs(existing) do
		if not seen[name] then
			row:Destroy()
		end
	end
end

local function EnableProximityESP()
	if not Alive then return end
	ProximityESP.Enabled = true
	task.spawn(CreateProximityGui)

	if ProximityConn then ProximityConn:Disconnect() end
	ProximityConn = RunService.Heartbeat:Connect(function()
		if not Alive or not ProximityESP.Enabled then return end
		local now = tick()
		if now - lastProxTick < PROX_RATE then return end
		lastProxTick = now

		local myChar = LP.Character
		local myRoot = myChar and GetRoot(myChar)
		if not myRoot then return end
		local myPos = myRoot.Position

		local entries = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP then
				local ch = p.Character
				if ch then
					local rt = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head")
					if rt then
						local dist = (myPos - rt.Position).Magnitude
						if dist <= ProximityESP.Distance then
							entries[#entries + 1] = {name = p.Name, dist = dist}
						end
					end
				end
			end
		end
		table.sort(entries, function(a, b) return a.dist < b.dist end)
		UpdateProximityList(entries)
	end)
end

