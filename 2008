local function safeNumberValue(v)
	if not v then return nil end
	local minV = (pcall(function() return v.MinValue end) and v.MinValue) or 0
	local maxV = (pcall(function() return v.MaxValue end) and v.MaxValue) or 100
	if type(minV) ~= "number" then minV = 0 end
	if type(maxV) ~= "number" then maxV = 100 end
	local ok, cur = pcall(function() return v.Value end)
	if not ok or type(cur) ~= "number" then cur = 0 end
	return cur, minV, maxV
end

local function safeRatio(v)
	local cur, minV, maxV = safeNumberValue(v)
	if cur == nil then return 1 end
	local range = maxV - minV
	if range <= 0 then return 1 end
	return math.clamp((cur - minV) / range, 0, 1)
end

