local function recalcBarPositions(player)
	local pd = EspData.PerPlayer[player]
	if not pd then return end
	local ri, li = 0, 0
	local slots = {
		{bb = pd.barBillboard, en = EspData.Enabled and EspData.ShowHealthBar, side = "right"},
		{bb = pd.stomachBillboard, en = EspData.Enabled and EspData.ShowStomachBar, side = "left"},
		{bb = pd.waterBillboard, en = EspData.Enabled and EspData.ShowWaterBar, side = "left"},
		{bb = pd.etherBillboard, en = EspData.Enabled and EspData.ShowEtherBar, side = "right"},
	}
	for _, sl in ipairs(slots) do
		if sl.en and sl.bb then
			if sl.side == "right" then
				ri = ri + 1
				sl.bb.StudsOffset = Vector3.new(2.3 + (ri - 1) * (BAR_W + BAR_GAP), 0, 0)
			else
				li = li + 1
				sl.bb.StudsOffset = Vector3.new(-(2.3 + (li - 1) * (BAR_W + BAR_GAP)), 0, 0)
			end
		end
	end
end

local function createPlayerBillboard(player, char)
	if player == LP or not char or not char.Parent then return end
	local head = char:FindFirstChild("Head")
	local root = head or char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local pd = EspData.PerPlayer[player]
	if pd and pd.billboard then
		if pd.billboard.Parent == root then return end
		pcall(function() pd.billboard:Destroy() end)
		pd.billboard = nil
		pd.label = nil
		pd.lastLabelText = nil
	end
	local yOff = head and 2.5 or 3.5
	local bg = Instance.new("BillboardGui")
	bg.Name = "PlayerESP"
	bg.Adornee = root
	bg.StudsOffsetWorldSpace = Vector3.new(0, yOff, 0)
	bg.AlwaysOnTop = true
	bg.ResetOnSpawn = false
	bg.LightInfluence = 0
	bg.Parent = root
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.AnchorPoint = Vector2.new(0.5, 1)
	lbl.Position = UDim2.new(0.5, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = EspData.Color
	lbl.TextStrokeTransparency = 0
	lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	lbl.Font = Enum.Font.Ubuntu
	lbl.TextScaled = false
	lbl.TextWrapped = false
	lbl.Text = ""
	lbl.Parent = bg
	szP(bg, lbl)
	pd = pd or {}
	pd.billboard = bg
	pd.label = lbl
	pd.lastLabelText = nil
	EspData.PerPlayer[player] = pd
end

