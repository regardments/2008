local function setupPlayerESP(player)
	if player == LP then return end
	EspData.PerPlayer[player] = EspData.PerPlayer[player] or {}
	local pd = EspData.PerPlayer[player]
	if pd.charConn then
		pd.charConn:Disconnect()
		pd.charConn = nil
	end
	pd.charConn = player.CharacterAdded:Connect(function(char)
		task.spawn(function()
			if not Alive or not EspData.Enabled then return end
			if not waitCharReady(char) then return end
			if not Alive or not EspData.Enabled then return end
			if player.Character ~= char then return end
			applyAllESPToChar(player, char)
		end)
	end)
	if player.Character then
